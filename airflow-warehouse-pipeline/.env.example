# .env.example
# Copy this file to .env and fill in real values.

# Airflow
AIRFLOW_UID=50000

# Postgres — warehouse-db service
DB_USER=warehouse_user
DB_PASSWORD=changeme
DB_NAME=warehouse_pipeline
DB_HOST=warehouse-db
DB_PORT=5432   # internal port — used by dbt and loader.py, inside the Docker network.
DB_HOST_PORT=5433    # host-side port — used by docker-compose.yaml's port mapping. This includes: pgAdmin, PowerBI and psql.